# Shared HakiOS boot flow. Device profiles may override hardware-specific commands.
bootdelay=0
bootretry=1
stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole

bootcmd=if hakios load; then run hakios_start; elif run hakios_sd_load; then run hakios_start; fi; run hakios_menu
hakios_start=hakios boot
hakios_menu=setenv bootcmd run hakios_menu; bootmenu -1

# Optional FAT32 SD-card source. The board profile must set a safe load address.
hakios_sd_dev=0
hakios_sd_part=1
hakios_sd_file=/hakios.hkub
hakios_sd_max=0x04000000
hakios_sd_load=if test -n "${hakios_sd_addr_r}"; then if mmc dev ${hakios_sd_dev}; then if fatload mmc ${hakios_sd_dev}:${hakios_sd_part} ${hakios_sd_addr_r} ${hakios_sd_file} ${hakios_sd_max}; then hakios load ${hakios_sd_addr_r} ${filesize}; else false; fi; else false; fi; else echo Set hakios_sd_addr_r in the board profile; false; fi

bootmenu_0=Start HakiOS loader=hakios load; hakios boot; pause
bootmenu_1=Boot HakiOS from SD card=if run hakios_sd_load; then hakios boot; else pause; fi
bootmenu_2=Drop to U-Boot shell=setenv bootretry -1
bootmenu_3=Show board information=bdinfo; meminfo; pause
bootmenu_4=Reset device=reset
